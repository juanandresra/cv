---
interface EducationItem {
	title: string;
	institution: string;
	date: string;
	location: string;
	pasantia?: string;
}

interface Props {
	title?: string;
	items: EducationItem[];
}

const { title = "EDUCACIÓN", items } = Astro.props;
---

<div class="flex flex-col gap-2.5">
	<h2 class="text-[#449399] font-bold text-sm tracking-wide uppercase underline underline-offset-4 decoration-2">
		{title}
	</h2>
	<ul class="flex flex-col gap-2">
		{
			items.map((item) => (
				<li class="flex flex-col text-xs leading-snug">
					<span class="font-bold text-gray-900 text-sm leading-tight">{item.title}</span>
					<span class="text-gray-700 text-xs font-medium">{item.institution}</span>
					<div class="italic text-xs text-[#449399] flex justify-between">
						<span>{item.date}</span>
						<span>{item.location}</span>
					</div>
					{item.pasantia && (
						<div class="mt-1 text-xs text-gray-700 leading-snug">
							<span class="font-semibold text-gray-800">Pasantía</span>
							<p class="flex items-start gap-1.5 mt-0.5">
								<span class="text-[#449399] font-bold">•</span>
								<span>{item.pasantia}</span>
							</p>
						</div>
					)}
				</li>
			))
		}
	</ul>
</div>
