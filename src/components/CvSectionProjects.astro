---
export interface ProjectFeature {
	name?: string;
	desc: string;
}

export interface ProjectItem {
	title: string;
	date: string;
	description?: string;
	features?: ProjectFeature[];
	skills?: string[];
}

interface Props {
	title?: string;
	items: ProjectItem[];
}

const { title = "PROYECTOS", items } = Astro.props;
---

<div class="flex flex-col gap-2.5">
	{title && (
		<h2 class="text-[#449399] font-bold text-sm tracking-wide uppercase underline underline-offset-4 decoration-2">
			{title}
		</h2>
	)}
	<ul class="flex flex-col gap-3.5">
		{
			items.map((item) => (
				<li class="flex flex-col text-xs leading-snug">
					<span class="font-bold text-gray-900 text-sm leading-tight">{item.title}</span>
					<span class="italic text-xs text-[#449399]">{item.date}</span>

					{item.description && (
						<p class="text-xs text-gray-700 leading-snug text-justify mt-0.5">
							{item.description}
						</p>
					)}

					{item.features && item.features.length > 0 && (
						<div class="mt-0.5">
							<span class="text-xs font-semibold text-gray-600 block">Características Clave</span>
							<ul class="flex flex-col gap-1 mt-0.5">
								{item.features.map((feat) => (
									<li class="flex items-start gap-1.5 text-xs text-gray-700 leading-snug text-justify">
										<span class="text-[#449399] font-bold shrink-0">•</span>
										<span>
											{feat.name && <strong class="font-bold text-gray-900">{feat.name}: </strong>}
											{feat.desc}
										</span>
									</li>
								))}
							</ul>
						</div>
					)}

					{item.skills && item.skills.length > 0 && (
						<ul class="flex flex-row flex-wrap gap-1.5 mt-1.5">
							{item.skills.map((skill: string) => (
								<li class="text-white text-[11px] font-medium bg-gray-400 rounded px-2 py-0.5 whitespace-nowrap">
									{skill}
								</li>
							))}
						</ul>
					)}
				</li>
			))
		}
	</ul>
</div>
