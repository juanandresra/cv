---
export interface SkillCategory {
	category: string;
	skills: string[];
}

interface Props {
	title?: string;
	categories: SkillCategory[];
}

const { title = "HABILIDADES", categories } = Astro.props;
---

<div class="flex flex-col gap-2.5">
	{title && (
		<h2 class="text-[#449399] font-bold text-sm tracking-wide uppercase underline underline-offset-4 decoration-2">
			{title}
		</h2>
	)}
	<div class="flex flex-col gap-2.5">
		{
			categories.map((cat) => (
				<div class="flex flex-col gap-1">
					<div class="text-xs font-bold text-gray-800 flex items-center gap-1.5 leading-tight">
						<span class="text-[#449399] font-bold">•</span>
						<span>{cat.category}</span>
					</div>
					<ul class="flex flex-row flex-wrap gap-1.5">
						{cat.skills.map((skill: string) => (
							<li class="text-white text-xs bg-gray-400 rounded px-2 py-0.5 whitespace-nowrap leading-tight">
								{skill}
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</div>