			<div class="flex flex-col gap-3 flex-1">
				<CvSectionEducation items={education} />
				<CvSectionExperience
					title="EXPERIENCIA LABORAL"
					items={experienceA}
				/>
			</div>
			<div class="flex flex-col gap-3 flex-1">
				<CvSectionExperience title="" items={experienceB} />
			</div>
		</div>
	</Page>

	<!-- PÁGINA 2: FORMACIÓN, HABILIDADES TÉCNICAS, IDIOMAS Y PROYECTOS -->
	<Page pageNumber={2} totalPages={3}>
		<div class="flex flex-row px-12 py-12 pb-10 gap-8 flex-1">
			<div class="flex flex-col gap-4 flex-1">
				<CvSectionSkills categories={allSkills} />
				<CvSectionLanguages items={languages} />
				<CvSectionProjects title="PROYECTOS" items={projectsA} />
			</div>
			<div class="flex flex-col flex-1">
				<CvSectionProjects title="" items={projectsB} />
			</div>
		</div>
	</Page>

	<!-- PÁGINA 3: PROYECTOS DE ANALÍTICA, TELEMETRÍA Y SISTEMAS -->
	<Page pageNumber={3} totalPages={3}>
		<div class="flex flex-row px-12 py-12 gap-8 flex-1">
